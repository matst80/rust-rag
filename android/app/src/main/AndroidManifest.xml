<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:appfn="http://schemas.android.com/apk/androidx.appfunctions">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".RagApplication"
        android:allowBackup="true"
        android:icon="@drawable/ic_brain"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_brain"
        android:supportsRtl="true"
        android:theme="@style/Theme.RustRag"
        appfn:description="@string/app_function_description"
        appfn:displayDescription="@string/app_function_display_description">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.RustRag">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Intent filter to handle search queries from App Actions/Gemini -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <!-- Support deep linking from schema "rustrag" -->
                <data android:scheme="rustrag" android:host="search" />
            </intent-filter>

            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <activity
            android:name=".ShareActivity"
            android:exported="true"
            android:label="@string/share_to_rag"
            android:theme="@style/Theme.RustRag.Dialog">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <service
            android:name=".QuickCaptureTileService"
            android:icon="@drawable/ic_brain"
            android:label="RAG Capture"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <receiver
            android:name=".RagSearchWidgetProvider"
            android:label="RAG Search"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/rag_search_widget_info" />
        </receiver>

        <property 
            android:name="android.app.appfunctions.app_metadata" 
            android:resource="@xml/app_metadata" />

    </application>

</manifest>
